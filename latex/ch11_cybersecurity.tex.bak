\section{Comprehensive Cybersecurity and Information Security Master Revision Sheet}

\subsection{Core Terms and Operational Definitions}

\begin{table}[htbp]
\centering
\caption{Cybersecurity and Information Security Quick Revision Sheet: Core Terms and Definitions}
\label{tab:cybersecurity_quick_revision}
\begin{tabularx}{\textwidth}{p{3.8cm} X}
\toprule
\textbf{Core Security Term} & \textbf{Concise Examination Definition} \\
\midrule
\textbf{CIA Triad} & Foundational information security model comprising Confidentiality, Integrity, and Availability. \\
\textbf{Confidentiality} & Preservation of authorized restrictions on information access and disclosure. \\
\textbf{Integrity} & Guarding against improper information modification or destruction; ensuring authenticity. \\
\textbf{Availability} & Ensuring timely and reliable access to and use of information and computing resources. \\
\textbf{Authentication} & Process of verifying the identity claimed by or for a system entity. \\
\textbf{Authorization} & Granting or denying access rights to a user, program, or process based on policy. \\
\textbf{Verification} & Confirmation that software requirements and design specifications are satisfied. \\
\textbf{Validation} & Confirmation that requirements for a specific intended use or application have been fulfilled. \\
\textbf{2FA} & Authentication requiring evidence from two distinct categories (Knowledge, Possession, Inherence). \\
\textbf{MFA} & Authentication requiring evidence from two or more independent authentication factor categories. \\
\textbf{Encryption} & Mathematical conversion of plaintext into ciphertext using a cipher and cryptographic key. \\
\textbf{Decryption} & Reverse transformation of ciphertext back into original plaintext using the authorized key. \\
\textbf{Cryptographic Hash} & Irreversible mathematical algorithm mapping arbitrary data to a unique fixed-size bit string. \\
\textbf{Cryptographic Salt} & Unique random data string concatenated with passwords prior to hashing to defeat precomputed attacks. \\
\textbf{Principle of Least Privilege} & Granting only the bare minimum privileges necessary to execute assigned functional responsibilities. \\
\textbf{Non-Repudiation} & Assurance that the sender or performer of an action cannot credibly deny having sent or performed it. \\
\textbf{DAC} & Access control where individual resource owners dictate permissions to other subjects at their discretion. \\
\textbf{MAC} & Access control enforced strictly by system security policies matching subject clearances to object labels. \\
\textbf{RBAC} & Access control based on user membership in defined enterprise organizational roles. \\
\textbf{ABAC} & Access control based on dynamic evaluation of subject, object, action, and environmental attributes. \\
\textbf{Access Control List (ACL)} & Table associating resource objects with authorized subjects and their permitted access rights. \\
\textbf{Defense in Depth} & Layered defense strategy providing multiple redundant security controls across architecture tiers. \\
\textbf{Zero Trust Architecture} & Security paradigm requiring continuous strict authentication and authorization regardless of network location. \\
\textbf{Separation of Duties (SoD)} & Dispersing critical operational steps among multiple actors to prevent fraud and catastrophic errors. \\
\textbf{Credential Stuffing} & Automated attack injecting stolen username-password pairs into web login forms at scale. \\
\bottomrule
\end{tabularx}
\end{table}

\subsection{Master Directory of Cyberattack Vectors}

\begin{table}[htbp]
\centering
\caption{Master Quick-Revision Summary: Core Cybersecurity Attack Vectors}
\label{tab:part2_attack_definitions}
\begin{tabularx}{\textwidth}{p{3.8cm} X}
\toprule
\textbf{Cybersecurity Vector} & \textbf{Essential Examination Rule and Architectural Definition} \\
\midrule
\textbf{Phishing} & Deceptive communication spoofing trusted organizations to steal credentials or implant malware. \\
\textbf{Social Engineering} & Psychological manipulation exploiting human cognitive trust, urgency, and fear to bypass controls. \\
\textbf{Man-in-the-Middle (MITM)} & Secret interception and potential alteration of communication between two mutually trusting endpoints. \\
\textbf{SQL Injection (SQLi)} & Subverting back-end database queries by incorporating unsanitized user input into dynamic queries. \\
\textbf{Cross-Site Scripting (XSS)} & Injecting malicious script into legitimate websites to execute in the security context of client browsers. \\
\textbf{Ransomware} & Extortion malware encrypting storage assets or locking operating systems to extort cryptocurrency ransoms. \\
\textbf{Zero-Day Attack} & Weaponizing a software vulnerability before the vendor has developed or released an effective security patch. \\
\textbf{Computer Virus} & Parasitic code that binds to host files and requires human execution to infect other system files. \\
\textbf{Computer Worm} & Standalone, self-replicating malware propagating autonomously across networks without human intervention. \\
\textbf{Trojan Horse} & Malicious payload masquerading as legitimate, benign software to deceive users into installation. \\
\textbf{Denial of Service (DoS)} & Intentionally exhausting computing, network, or application resources to deny access to authorized users. \\
\textbf{Distributed DoS (DDoS)} & Overwhelming a target with synchronized volumetric or protocol floods launched from botnets. \\
\textbf{Address Spoofing} & Forging network layer headers (IP, ARP, DNS, MAC) to falsify origin identity and redirect traffic. \\
\textbf{Replay Attack} & Capturing valid cryptographic tokens or network transmissions and fraudulently replaying them. \\
\textbf{Session Hijacking} & Taking unauthorized control of an authenticated web session by acquiring its session identifier. \\
\textbf{Privilege Escalation} & Subverting access boundaries to acquire unauthorized higher administrative or horizontal peer rights. \\
\bottomrule
\end{tabularx}
\end{table}

\subsection{Architectural Invariant Rules for Final Revision}

\subsubsection{Data Lifecycle Protection Invariants}
\begin{itemize}
    \item \textbf{Data at Rest:} Stationary information stored on non-volatile media (SSDs, databases, SANs, backups). Protected primarily via symmetric block ciphers (AES-256), cryptographic key rotation, and strict file/database access controls.
    \item \textbf{Data in Transit:} Dynamic data traversing network media (LAN, WAN, Internet). Protected primarily via TLS 1.3, IPsec (ESP), SSHv2, and cryptographic certificate validation to guarantee confidentiality, integrity, and non-repudiation.
    \item \textbf{Data in Use:} Active data undergoing evaluation within system RAM, CPU caches, and execution registers. Protected via memory address space layout randomization (ASLR), process sandboxing, hardware enclaves (Intel SGX), and Least Privilege execution.
\end{itemize}

\subsubsection{Layer 2 Dynamic ARP Inspection (DAI) Invariants}
\begin{itemize}
    \item \textbf{ARP Fundamentals:} Resolves 32-bit IPv4 addresses to 48-bit MAC addresses on local broadcast domains; lacks built-in authentication.
    \item \textbf{ARP Poisoning Mitigation:} DAI validates ARP request and reply frames on untrusted switch interfaces against the trusted DHCP Snooping Binding Database.
    \item \textbf{Interface Trust Policy:} Trunk links and gateway uplinks are marked \textbf{trusted} (DAI inspection bypassed); access ports are marked \textbf{untrusted} (inspected).
    \item \textbf{Static IP Accommodation:} Statically addressed infrastructure devices (servers, routers, printers) bypass dynamic DHCP snooping via explicitly configured \textbf{ARP ACLs}.
\end{itemize}

\subsection{High-Priority Examination Preparation Strategy}

\begin{enumerate}
    \item \textbf{Master the CIA Triad Invariants:} Rapidly diagnose CIA violations: unauthorized viewing is Confidentiality; unauthorized modification is Integrity; service disruption is Availability.
    \item \textbf{Contrast Core Pairs:} Memorize exact definitions: Authentication (identity verification) vs. Authorization (permission check); Verification (conformance to specs) vs. Validation (fitness for purpose); Encryption (reversible) vs. Hashing (one-way).
    \item \textbf{Articulate Web Vulnerabilities:} Detail SQL Injection (neutralized via parameterized queries / prepared statements) versus XSS (neutralized via context-aware output encoding, CSP, and \texttt{HttpOnly} cookies).
    \item \textbf{Navigate Layer 2 Switch Defenses:} Explain the collaborative relationship between DHCP Snooping (which builds the binding database) and DAI (which queries it to drop forged ARP frames).
    \item \textbf{Execute Incident Response Workflows:} Detail the 6-phase ransomware incident response lifecycle (Preparation $\to$ Detection/Analysis $\to$ Containment $\to$ Eradication $\to$ Recovery $\to$ Post-Incident Review), prioritizing offline immutable backups and immediate host isolation.
\end{enumerate}

